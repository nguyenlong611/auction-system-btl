    <!-- ============================================================== -->
    <!-- CREATE VIEW (hidden)                                           -->
    <!-- ============================================================== -->
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="view-scroll" visible="false" managed="false"
                fx:id="viewCreate">
      <VBox alignment="TOP_CENTER">
        <padding><Insets top="32" bottom="64" left="32" right="32"/></padding>
        <VBox spacing="0">
          <!-- Back button -->
          <Button text="← Back" styleClass="back-btn" onAction="#onBackFromCreate">
            <VBox.margin><Insets bottom="24"/></VBox.margin>
          </Button>
          <Label styleClass="page-title" text="List an Item"/>
          <Label styleClass="page-subtitle" text="Fill in the details below to start your auction.">
            <VBox.margin><Insets top="8" bottom="32"/></VBox.margin>
          </Label>

          <!-- Form Card -->
          <VBox styleClass="form-card" maxWidth="700">
            <padding><Insets top="32" right="32" bottom="32" left="32"/></padding>

            <!-- Item Details Section -->
            <Label styleClass="form-section-title" text="ITEM DETAILS">
              <VBox.margin><Insets bottom="16"/></VBox.margin>
            </Label>

            <!-- Title -->
            <VBox spacing="6">
              <VBox.margin><Insets bottom="18"/></VBox.margin>
              <Label styleClass="form-label" text="Title *"/>
              <TextField fx:id="createTitle" styleClass="form-input" promptText="e.g., 1967 Vintage Gibson Les Paul Guitar"/>
            </VBox>

            <!-- Description -->
            <VBox spacing="6">
              <VBox.margin><Insets bottom="18"/></VBox.margin>
              <Label styleClass="form-label" text="Description *"/>
              <TextArea fx:id="createDesc" styleClass="form-textarea" promptText="Describe your item in detail — condition, provenance, what's included…"
                        prefRowCount="4" wrapText="true"/>
            </VBox>

            <!-- Category + Condition Row -->
            <HBox spacing="16">
              <VBox.margin><Insets bottom="18"/></VBox.margin>
              <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label styleClass="form-label" text="Category *"/>
                <ComboBox fx:id="createCategory" styleClass="form-select" promptText="Select category" maxWidth="Infinity">
                  <items>
                    <FXCollections fx:factory="observableArrayList">
                      <String fx:value="Electronics"/>
                      <String fx:value="Jewelry &amp; Watches"/>
                      <String fx:value="Art &amp; Collectibles"/>
                      <String fx:value="Vehicles"/>
                      <String fx:value="Musical Instruments"/>
                      <String fx:value="Antiques"/>
                      <String fx:value="Fashion"/>
                      <String fx:value="Sports &amp; Outdoors"/>
                      <String fx:value="Other"/>
                    </FXCollections>
                  </items>
                </ComboBox>
              </VBox>
              <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label styleClass="form-label" text="Condition"/>
                <ComboBox fx:id="createCondition" styleClass="form-select" maxWidth="Infinity" value="Mint">
                  <items>
                    <FXCollections fx:factory="observableArrayList">
                      <String fx:value="Mint"/>
                      <String fx:value="Excellent"/>
                      <String fx:value="Good"/>
                      <String fx:value="Fair"/>
                      <String fx:value="Poor"/>
                    </FXCollections>
                  </items>
                </ComboBox>
              </VBox>
            </HBox>

            <!-- Image Upload Area -->
            <VBox spacing="6">
              <VBox.margin><Insets bottom="18"/></VBox.margin>
              <HBox spacing="4">
                <Label styleClass="form-label" text="Item Image"/>
                <Label styleClass="form-label-muted" text="(optional)"/>
              </HBox>
              <VBox styleClass="image-upload-box" alignment="CENTER">
                <padding><Insets top="24" bottom="24" left="24" right="24"/></padding>
                <Label text="🖼️" style="-fx-font-size: 32px;">
                  <VBox.margin><Insets bottom="6"/></VBox.margin>
                </Label>
                <Label styleClass="upload-title" text="Click to choose an image"/>
                <Label styleClass="upload-subtitle" text="or drag &amp; drop — JPG, PNG, WEBP, GIF"/>
              </VBox>
            </VBox>

            <!-- Divider -->
            <Region styleClass="divider">
              <VBox.margin><Insets top="16" bottom="16"/></VBox.margin>
            </Region>

            <!-- Pricing Section -->
            <Label styleClass="form-section-title" text="PRICING &amp; DURATION">
              <VBox.margin><Insets bottom="16"/></VBox.margin>
            </Label>

            <!-- Price + Duration Row -->
            <HBox spacing="16">
              <VBox.margin><Insets bottom="12"/></VBox.margin>
              <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label styleClass="form-label" text="Starting Bid (\$) *"/>
                <TextField fx:id="createStartPrice" styleClass="form-input" promptText="100"/>
              </VBox>
              <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label styleClass="form-label" text="Auction Duration *"/>
                <ComboBox fx:id="createDuration" styleClass="form-select" maxWidth="Infinity" value="7 Days">
                  <items>
                    <FXCollections fx:factory="observableArrayList">
                      <String fx:value="1 Day"/>
                      <String fx:value="3 Days"/>
                      <String fx:value="5 Days"/>
                      <String fx:value="7 Days"/>
                      <String fx:value="14 Days"/>
                    </FXCollections>
                  </items>
                </ComboBox>
              </VBox>
            </HBox>

            <!-- Error -->
            <Label fx:id="createError" styleClass="field-error" text="" minHeight="16">
              <VBox.margin><Insets bottom="12"/></VBox.margin>
            </Label>

            <!-- Submit -->
            <Button text="🔨 List Item for Auction" styleClass="btn-primary-lg" onAction="#onCreateAuction"/>
          </VBox>
        </VBox>
      </VBox>
    </ScrollPane>

  </StackPane>

